# 如果需要外网访问 请改成0.0.0.0
HOST=127.0.0.1
PORT=9999
LOG_LEVEL=INFO
DRIVER=~fastapi+~httpx+~websockets
QQ_IS_SANDBOX=false                      #是否为沙盒模式
# 适配器二选一：qq_official（QQ 官方机器人）| onebot11（OneBot V11）
BOT_ADAPTER = qq_official

# ===== 以下仅在 BOT_ADAPTER=onebot11 时需要 =====
# 默认反向 WebSocket
# ws://127.0.0.1:9999/onebot/v11/ws
# 正向 WebSocket：机器人主动连实现端，填实现端地址（JSON 数组，可填多个）
# ONEBOT_WS_URLS = ["ws://127.0.0.1:3001"]

# 连接的token 需与实现端一致，留空表示不校验
# ONEBOT_ACCESS_TOKEN = ""

# 超级管理员（nonebot 标准配置）。隐藏指令 wws推送 只有超级管理员能用。
# 这里要填**群内**那个：在群里发一条 wws 指令，日志里的 PlatformId= 即是。
SUPERUSERS = ["这里填群内 openid"]
QQ_BOTS='
[
  {
    "id": "xxx",
    "token": "xxx",
    "secret": "xxx",
    "intent": {
      "c2c_group_at_messages": true,
      "direct_message": true
    }
  }
]
'

htmlrender_browser = "chromium"         #默认使用chromium启动，出现问题了请改为"firefox"尝试
COMMAND_START=[""] #指令触发前缀 为空表示不需要任何前缀
API_TOKEN = 123456:qwertyuiopasdfghjl  #请加群发送.token help获取api_key和token Q群:967546463，直接用邮件中的token替换前面这串字符串就行了，没有引号

BOT_SELECT_MSG_IS_MD = false          #选择类消息是否使用md格式发送，默认false
BOT_SELECT_MSG_IS_MD_MAX_SIZE = 10   #选择类消息最多展示的选择数量，默认10
BOT_ENABLE_FILE_LISTEN = false        #是否启用文件消息监听（私聊/群/频道收到文件附件时触发处理），默认false
BOT_BROADCAST_INTERVAL = 3            #群推送每条间隔的**上限**（群少时用这个值），平台限单关系主动消息 20 条/分钟
BOT_BROADCAST_MIN_INTERVAL = 1        #自动计算间隔的**下限**：平台 Bot 维度频控底线，再快会被限流
BOT_BROADCAST_BUDGET = 270            #整轮推送的时间预算（秒）。被动回复有效期 5 分钟，默认留 30 秒冗余

proxy_on = false                 #是否启用代理
proxy = http://localhost:7890   #代理地址，如果上面选项开启，这边替换为你本地的
http2 = true                    #是否开启http2，默认开启，如果有问题请设置为false